# DeepSeek API key (https://platform.deepseek.com/api_keys). Used when an agent backend is `deepseek`.
DEEPSEEK_API_KEY=sk-...
# Optional override for the DeepSeek model id (otherwise taken from config.yaml).
# DEEPSEEK_MODEL=deepseek-flash

# Optional override for the LM Studio model id (otherwise taken from config.yaml or /v1/models).
# LMSTUDIO_MODEL=qwen2.5-32b-instruct
